    "minimapGutter.modifiedBackground": "#9EBDD0",
    "minimapGutter.deletedBackground": "#EB8A80",
    "window.activeBorder": "#4B382D",
    "window.inactiveBorder": "#4B382D",
    "terminalCursor.background": "#191210",
    "terminalOverviewRuler.border": "#4B382D",
    "searchEditor.findMatchBackground": "#E6B86A10",
    "searchEditor.findMatchBorder": "#E8AC71",
    "searchEditor.textInputBorder": "#4B382D",
    "debugIcon.stepOverForeground": "#E8AC71",
    "debugIcon.stepIntoForeground": "#E8AC71",
    "debugIcon.stepOutForeground": "#E8AC71",
    "debugIcon.continueForeground": "#B2BD8A",
    "debugIcon.stepBackForeground": "#D5BB91",
    "debugIcon.breakpointDisabledForeground": "#A28F7D",
    "debugIcon.breakpointUnverifiedForeground": "#D4A291",
    "debugIcon.breakpointCurrentStackframeForeground": "#E6B86A",
    "debugIcon.breakpointStackframeForeground": "#B2BD8A",
