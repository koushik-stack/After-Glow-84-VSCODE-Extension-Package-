{
  "name": "afterglow-84",
  "displayName": "Afterglow ’84",
  "version": "0.6.0",
  "publisher": "Retrocoder",
  "description": "A warm retro VS Code theme inspired by afternoon sunlight, vintage computers, and plum-colored sunsets.",
  "author": {
    "name": "Abu Koushik"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "retro",
    "sunset",
    "warm"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#211A24",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Afterglow ’84",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Night Drive",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-night-drive-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Golden Hour",
        "uiTheme": "vs",
        "path": "./themes/afterglow-84-golden-hour-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Retro Amber",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-retro-amber-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Dark Roast",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-dark-roast-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Mocha Retro",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-mocha-retro-color-theme.json"
      },
      {
        "label": "Afterglow ’84 — Midnight Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/afterglow-84-midnight-mocha-color-theme.json"
      }
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-theme.mjs && node scripts/validate-dark-roast.mjs && node scripts/validate-mocha-retro.mjs && node scripts/validate-midnight-mocha.mjs",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "node --test scripts/validate-family.test.mjs scripts/release.test.mjs",
    "package:check": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "js-yaml": "4.3.2",
    "yauzl": "3.4.0"
  }
}
