  "tokenColors": [
    {
      "name": "Base text",
      "scope": [
        "source",
        "text.html",
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#E8D5BF",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A28F7D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#B2BD8A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D4A291"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D4A291"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D98B73"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E6B86A"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#D5BB91"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#E8D5BF"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8D5BF"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C7B39C"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#D5BB91"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D4A291"
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#D98B73"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#E6B86A"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#D5BB91"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "meta.property-name.scss"
      ],
      "settings": {
        "foreground": "#E8D5BF"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E6B86A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#D5BB91",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E6B86A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D4A291",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#B2BD8A"
      }
    },
    {
      "name": "Inserted markup",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#B2BD8A"
      }
    },
    {
      "name": "Deleted markup",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EB8A80"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#EB8A80",
        "fontStyle": "underline"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E8D5BF"
      }
    },
    {
      "name": "Regex bodies and escapes",
      "scope": [
        "string.regexp",
        "constant.character.escape.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D4A291"
      }
    },
    {
      "name": "Named callables",
      "scope": [
        "variable.function"
      ],
      "settings": {
        "foreground": "#E6B86A"
      }
    },
    {
      "name": "Markup bold italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#E6B86A",
        "fontStyle": "bold italic"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#A28F7D",
      "italic": true,
      "bold": false
    },
    "string": "#B2BD8A",
    "keyword": "#D98B73",
    "number": "#D4A291",
    "regexp": "#D4A291",
    "operator": "#C7B39C",
    "namespace": "#D5BB91",
    "type": "#D5BB91",
    "typeParameter": "#D5BB91",
    "class": "#D5BB91",
    "enum": "#D5BB91",
    "interface": "#D5BB91",
    "struct": "#D5BB91",
    "function": "#E6B86A",
    "method": "#E6B86A",
    "macro": "#E6B86A",
    "variable": "#E8D5BF",
    "parameter": "#E8D5BF",
    "property": "#E8D5BF",
    "enumMember": "#D4A291",
    "event": "#E6B86A",
    "decorator": "#D4A291",
    "label": "#D98B73",
    "variable.readonly": "#D4A291",
    "property.readonly": "#D4A291",
    "*.deprecated": {
      "foreground": "#EB8A80",
      "strikethrough": true
    }
  }
}
